# ================================================================
# 1. SERVER & ENVIRONMENT CONFIGURATION
# ================================================================
PORT=3001
NODE_ENV=production
APP_URL=https://api.raysautocare.id
CLIENT_URL=https://raysautocare.id
CORS_ORIGIN=https://raysautocare.id,https://www.raysautocare.id,https://admin.raysautocare.id

# ================================================================
# 2. DATABASE CONFIGURATION
# Mendukung PostgreSQL lokal & MySQL Hostinger
# Format MySQL: mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME
# Jika password ada karakter khusus, lakukan URL-encode pada password.
# ================================================================
DATABASE_URL=mysql://u123456789_user:PasswordKuat123@127.0.0.1:3306/u123456789_rays_autocare
DATABASE_DIALECT=mysql

# ================================================================
# 3. AUTHENTICATION & JWT TOKENS
# Wajib diganti dengan string acak aman yang berbeda untuk masing-masing secret:
# Generate di terminal: openssl rand -hex 64
# ================================================================
JWT_SECRET=GANTI_DENGAN_RANDOM_SECRET_JWT_KEY_MINIMAL_32_KARAKTER
REFRESH_TOKEN_SECRET=GANTI_DENGAN_RANDOM_SECRET_REFRESH_TOKEN_KEY_MINIMAL_32_KARAKTER
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ================================================================
# 4. GOOGLE OAUTH CREDENTIALS (Opsional - Login with Google)
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
# ================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ================================================================
# 5. EMAIL SMTP CONFIGURATION (OTP & Notifikasi)
# Untuk Hostinger Email:
# Host: smtp.hostinger.com, Port: 465 (SSL)
# ================================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@raysautocare.id
SMTP_PASS=PasswordMailboxHostinger
SMTP_FROM="Rays Autocare <support@raysautocare.id>"
# Aktifkan sementara untuk melihat detail koneksi SMTP di Runtime Logs.
SMTP_DEBUG=false

# ================================================================
# 6. GOOGLE ANALYTICS 4 (GA4) - Opsional untuk Dashboard CMS
# ================================================================
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# ================================================================
# 7. META PIXEL & CONVERSIONS API (CAPI) - Opsional untuk Iklan
# ================================================================
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
