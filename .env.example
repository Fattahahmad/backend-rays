# ================================================================
# Konfigurasi awal production untuk Hostinger Node.js Web App
# ================================================================
# PORT tidak perlu diatur. Hostinger akan menyediakannya otomatis.

NODE_ENV=production

# Frontend/CMS yang boleh mengakses API.
CORS_ORIGIN=https://raysautocare.id,https://www.raysautocare.id,https://admin.raysautocare.id
APP_URL=https://api.raysautocare.id
CLIENT_URL=https://raysautocare.id

# Wajib diganti dengan dua nilai acak yang berbeda.
# Buat masing-masing dengan: openssl rand -hex 64
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ================================================================
# Database MySQL Hostinger
# Aktifkan setelah database dan user MySQL selesai dibuat.
# Gunakan host, username, password, dan nama database dari hPanel.
# Jika password mengandung karakter khusus, URL-encode password-nya.
# ================================================================
# DATABASE_DIALECT=mysql
# DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME
# RUN_DATABASE_SEED=true

# ================================================================
# SMTP Hostinger
# Host dan port sudah benar untuk Hostinger Email.
# Aktifkan USER, PASS, dan FROM setelah mailbox selesai dibuat.
# Tanpa kredensial ini aplikasi tetap hidup, tetapi email tidak terkirim.
# ================================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# SMTP_USER=no-reply@raysautocare.id
# SMTP_PASS=PASSWORD_MAILBOX
# SMTP_FROM=Rays Autocare <no-reply@raysautocare.id>

# ================================================================
# Google Login (opsional)
# Aktifkan hanya jika fitur Google Login digunakan.
# ================================================================
# GOOGLE_CLIENT_ID=GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_CLIENT_SECRET=GOOGLE_OAUTH_CLIENT_SECRET

# ================================================================
# Google Analytics 4 (opsional)
# ================================================================
# GA4_PROPERTY_ID=123456789
# GA4_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ================================================================
# Meta Pixel / Conversions API (opsional)
# ================================================================
# META_PIXEL_ID=123456789012345
# META_ACCESS_TOKEN=META_SYSTEM_USER_ACCESS_TOKEN
# META_TEST_EVENT_CODE=TEST12345
