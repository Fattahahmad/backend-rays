# Server Configuration
PORT=3000
# PENTING: Ubah 'development' menjadi 'production' saat aplikasi di-deploy ke server live (Hostinger/VPS).
# Mode 'production' akan:
# 1. Mengaktifkan proteksi CORS ketat (menolak origin asing)
# 2. Menyembunyikan stack trace error database agar tidak bocor ke publik
# 3. Mengoptimalkan performa server
NODE_ENV=development

# CORS Configuration (Domain Whitelist)
# Masukkan URL domain resmi Frontend & CMS yang diizinkan mengakses backend API (pisahkan dengan koma jika multi-domain).
# JANGAN gunakan '*' saat live di server production!
# Contoh Production (Wajib gunakan HTTPS dan domain resmi):
# CORS_ORIGIN=https://raysautocare.com,https://admin.raysautocare.com,https://www.raysautocare.com
# Contoh Development (Localhost Frontend / Vite / Next.js):
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://username:password@localhost:5432/rays_autocare

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Configuration (Dual-Token Auth & Session Management)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_here
REFRESH_TOKEN_EXPIRES_IN=7d

# Google Analytics 4 (GA4) Configuration (Optional / Admin CMS Dashboard)
GA4_PROPERTY_ID=123456789
GA4_CLIENT_EMAIL=rays-analytics-service@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...\n-----END PRIVATE KEY-----\n"

# Meta Pixel & Conversions API (CAPI) Configuration (Facebook & Instagram Ads Tracking)
META_PIXEL_ID=123456789012345
META_ACCESS_TOKEN=EAAG...your_meta_system_user_access_token_here
META_TEST_EVENT_CODE=TEST12345 # Optional: Digunakan saat pengujian di Meta Events Manager Test Events Tab

# Email SMTP Configuration (Mailtrap for Development / Hostinger for Production)
# --- Contoh Development (Mailtrap Sandbox) ---
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_user_token
# SMTP_PASS=your_mailtrap_pass_token
#
# --- Contoh Production (Hostinger Titan / Webmail) ---
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=admin_email_domain_anda
# SMTP_PASS=sandi_email_domain_anda
#
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM="Rays Autocare <no-reply@example.com>"


