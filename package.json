{
  "name": "backend-rays",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate": "node-pg-migrate -m database/migrations",
    "db:create": "tsx database/create_db.ts",
    "db:reset": "tsx database/reset_db.ts",
    "migrate:up": "tsx database/create_db.ts && node-pg-migrate -m database/migrations up",
    "migrate:down": "node-pg-migrate -m database/migrations down",
    "migrate:create": "node-pg-migrate -m database/migrations -j sql create",
    "db:export": "tsx database/export_mysql.ts",
    "db:seed": "tsx database/seed.ts"
  },
  "author": "Fattah Ahmad",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google-analytics/data": "^7.2.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.1.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
