{
  "name": "backend-rays",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate": "node-pg-migrate -m database/migrations",
    "db:create": "tsx database/create_db.ts",
    "db:reset": "tsx database/reset_db.ts",
    "migrate:up": "tsx database/create_db.ts && node-pg-migrate -m database/migrations up",
    "migrate:down": "node-pg-migrate -m database/migrations down",
    "migrate:create": "node-pg-migrate -m database/migrations -j sql create",
    "db:export": "tsx database/export_mysql.ts"
  },
  "author": "Fattah Ahmad",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
